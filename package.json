{
  "name": "decibel-trading-agent-v3",
  "version": "3.0.0",
  "description": "Unified 24/7 autonomous perpetual futures trading agent for Decibel Exchange on Aptos (Client V3)",
  "main": "desktop/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.json",
    "build:release": "node scripts/build-release.js",
    "build:desktop": "npm run build && electron-builder",
    "desktop": "electron desktop/main.js",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "setup": "ts-node scripts/setup.ts",
    "pair": "ts-node scripts/pair.ts",
    "status": "ts-node scripts/status.ts",
    "test:telegram": "ts-node scripts/test-telegram.ts",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "backup": "bash scripts/backup-version.sh",
    "deploy": "bash scripts/deploy-to-jetson.sh",
    "rollback": "bash scripts/rollback-jetson.sh",
    "reset-password": "node scripts/reset-admin-password.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:onboard": "tsx scripts/test-onboarding-wizard-e2e.ts"
  },
  "build": {
    "appId": "com.decibel.tradingagent.v3",
    "productName": "Alpha Autonomous Client v3",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dashboard/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@modelcontextprotocol/sdk": "^1.13.1",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "got": "^11.8.6",
    "node-telegram-bot-api": "^0.66.0",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/ws": "^8.5.14",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}