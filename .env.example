# ==============================================================================
#  DECIBEL DEX AUTONOMOUS CLIENT AGENT — ENVIRONMENT CONFIGURATION
#  ⚠️  Copy this file to .env and fill in your credentials. Safe to commit.
# ==============================================================================

# ── 1. Decibel DEX Credentials (Required for Live Trading) ────────────────────
DECIBEL_NETWORK=mainnet
DECIBEL_DELEGATE_KEY=
DECIBEL_SUBACCOUNT_ADDRESS=
DECIBEL_NODE_API_KEY=
DECIBEL_APTOS_OWNER_ADDRESS=

# ── 2. Client AI Brain (Pick ONE for your VPS, Mac, or GPU) ───────────────────
# Option A: Google Gemini (Low cost / high speed)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Anthropic Claude / Custom Gateway
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Option C: Local Hardware AI (Default for Jetson / Mac / 100% Offline)
# OLLAMA_BASE_URL=http://localhost:11434

# ── 3. Optional Sim Lab AI Cloud Supercharge ──────────────────────────────────
# Leave blank for 100% Pure Standalone Mode
# Paste token (simlab_live_...) to unlock Sim Lab macro overlay
SIMLAB_KEY=

# Localhost Testing Override (Optional):
# SIMLAB_SERVER_URL=http://localhost:4000

# ─── Central Alpha Server Pipeline (Smart Local First + Public Cloudflare Auto-Failover) ────
# Primary Target (Default: Public Cloudflare for instant zero-config remote/onboard use):
SIM_PIPELINE_URL=https://simlab.measmony.me/api/pipeline/alpha-bundle
SIM_TELEMETRY_URL=https://simlab.measmony.me/api/pipeline/telemetry

# (Optional: If running in Local LAN testing mode, you can set Local as primary and Cloudflare as fallback):
# SIM_PIPELINE_URL=http://192.168.100.21:4000/api/pipeline/alpha-bundle
# SIM_TELEMETRY_URL=http://192.168.100.21:4000/api/pipeline/telemetry
SIM_PIPELINE_FALLBACK_URL=https://simlab.measmony.me/api/pipeline/alpha-bundle
SIM_TELEMETRY_FALLBACK_URL=https://simlab.measmony.me/api/pipeline/telemetry
CLIENT_ID=alpha_client_v3
CLIENT_NAME=Alpha Autonomous Client v3
# API License Connection Token (unlocks proprietary strategy layers & profit harvester)
# Leave blank for clean standalone / paste real key generated from Sim Lab server:
CLIENT_API_KEY=
# Or use full connection token:
# SIMLAB_CONNECTION_TOKEN=simlab_live_...
SIM_PIPELINE_POLL_MS=15000
SIM_TELEMETRY_INTERVAL_MS=30000
SIM_PIPELINE_ENABLED=true

# ── 4. Trading Settings ───────────────────────────────────────────────────────
BUDGET_USD=30.00
PAPER_TRADING=true
WATCH_PAIRS=BTC/USD,ETH/USD,SOL/USD,APT/USD,SUI/USD,XRP/USD,DOGE/USD,BNB/USD,LINK/USD,AVAX/USD,NEAR/USD,ADA/USD
POLL_INTERVAL_MS=15000

# ── 5. Risk Management Limits ─────────────────────────────────────────────────
MAX_RISK_PER_TRADE_PCT=30
MIN_24H_VOLUME_USD=100000
MAX_FUNDING_RATE_PCT=0.3
HIGH_VOLATILITY_THRESHOLD_PCT=15
MAX_LEVERAGE=5
MAX_ALLOC_PCT=35

# ── 6. Optional Telegram Notifications ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 7. Health & Dashboard Server ──────────────────────────────────────────────
HEALTH_PORT=5050
LOG_LEVEL=info
LOG_FILE=./logs/trading-assistant.log
